{
  "name": "skills-master-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Tool-agnostic Apple & Android development skills, installable into any AI coding tool.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @ichintansoni/skills-master build",
    "format": "biome format --write .",
    "lint:ts": "biome check .",
    "test": "pnpm --filter @ichintansoni/skills-master test",
    "typecheck": "pnpm --filter @ichintansoni/skills-master typecheck",
    "cli": "pnpm --filter @ichintansoni/skills-master exec tsx src/bin.ts",
    "skills:lint": "pnpm --filter @ichintansoni/skills-master exec tsx src/bin.ts lint --content ../../skills",
    "skills:registry": "pnpm --filter @ichintansoni/skills-master exec tsx src/bin.ts registry build --content ../../skills",
    "skills:marketplace": "pnpm --filter @ichintansoni/skills-master exec tsx src/bin.ts marketplace build --content ../../skills --out ../..",
    "test:coverage": "pnpm --filter @ichintansoni/skills-master test:coverage",
    "spec:validate": "python3 scripts/spec-validate.py",
    "crawl": "pnpm exec tsx scripts/crawl/bin.ts",
    "crawl:report": "node scripts/crawl/report.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
